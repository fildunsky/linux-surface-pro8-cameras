 void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 {
+	/*
+	 * Привести суммы по каналам к восьмибитному масштабу. Копятся они в
+	 * родных отсчётах сенсора (для десятибитного — 0..1023), а
+	 * единственный потребитель, вычитание уровня чёрного в Awb, берёт
+	 * blc.level, который восьмибитный. Без приведения у десятибитного
+	 * сенсора вычитается вчетверо меньше нужного, и баланс белого
+	 * промахивается тем сильнее, чем темнее сцена. Гистограмма яркости
+	 * приводится к восьми битам прямо при накоплении (параметр div у
+	 * SWSTATS_ACCUMULATE_LINE_STATS), суммы же делятся здесь, после
+	 * накопления, чтобы не терять точность на каждом пикселе.
+	 */
+	if (sumDiv_ > 1)
+		stats_.sum_ = stats_.sum_ / static_cast<uint64_t>(sumDiv_);
+
 	stats_.valid = frame % kStatPerNumFrames == 0;
 	*sharedStats_ = stats_;
 	statsReady.emit(frame, bufferId);
