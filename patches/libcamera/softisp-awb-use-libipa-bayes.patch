 #include "libipa/colours.h"
 #include "simple/ipa_context.h"
 
@@ -25,6 +28,71 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+/*
+ * Софтовый ISP не считает освещённость, а байесовскому AWB она нужна
+ * только чтобы выбрать априорное распределение. Берём то же значение,
+ * что и апстрим в d5d00b9c.
+ */
+static constexpr unsigned int kDefaultLux = 500;
+
+/*
+ * Переходник между статистикой софтового ISP и интерфейсом libipa.
+ * Средние по каналам libipa ждёт в виде RGB<double>.
+ */
+class SimpleAwbStats final : public AwbStats
+{
+public:
+	SimpleAwbStats() = default;
+
+	explicit SimpleAwbStats(const RGB<double> &rgbMeans)
+		: rgbMeans_(rgbMeans)
+	{
+		rg_ = rgbMeans_.r() / rgbMeans_.g();
+		bg_ = rgbMeans_.b() / rgbMeans_.g();
+	}
+
+	double computeColourError(const RGB<double> &gains) const override
+	{
+		/*
+		 * Сумма квадратов отклонения от серого — та самая величина,
+		 * что стоит в уравнении правдоподобия.
+		 */
+		double deltaR = gains.r() * rg_ - 1.0;
+		double deltaB = gains.b() * bg_ - 1.0;
+
+		return deltaR * deltaR + deltaB * deltaB;
+	}
+
+	RGB<double> rgbMeans() const override
+	{
+		return rgbMeans_;
+	}
+
+private:
+	RGB<double> rgbMeans_ = RGB<double>({ 1.0, 1.0, 1.0 });
+	double rg_ = 1.0;
+	double bg_ = 1.0;
+};
+
+int Awb::init(IPAContext &context, const YamlObject &tuningData)
+{
+	auto algo = std::make_unique<AwbBayes>();
+	int ret = algo->init(tuningData);
+	if (ret) {
+		LOG(IPASoftAwb, Info)
+			<< "В тюнинге нет кривой colourGains, баланс белого "
+			   "остаётся на сером мире";
+		return 0;
+	}
+
+	for (const auto &c : algo->controls())
+		context.ctrlMap[c.first] = c.second;
+
+	awbAlgo_ = std::move(algo);
+
+	return 0;
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
@@ -76,19 +144,47 @@ void Awb::process(IPAContext &context,
 	 */
 	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
 
-	/*
-	 * Calculate red and blue gains for AWB.
-	 * Clamp max gain at 4.0, this also avoids 0 division.
-	 */
 	auto &gains = context.activeState.awb.gains;
-	gains = { {
-		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
-		1.0,
-		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
-	} };
 
-	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
-	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	if (awbAlgo_) {
+		/*
+		 * Байесовский AWB из libipa. В отличие от серого мира он не
+		 * тянет среднее по кадру к серому вслепую, а выбирает
+		 * наиболее правдоподобный источник света на калиброванной
+		 * кривой colourGains из файла тюнинга. Кривая у нас взята из
+		 * заводского .aiqb, поэтому ответ ограничен теми
+		 * источниками, которые физически снимались на этом
+		 * экземпляре оптики.
+		 */
+		const SimpleAwbStats awbStats{ RGB<double>({
+			static_cast<double>(sum.r()),
+			static_cast<double>(sum.g()),
+			static_cast<double>(sum.b()),
+		}) };
+
+		const AwbResult result = awbAlgo_->calculateAwb(awbStats, kDefaultLux);
+
+		gains = { {
+			std::clamp(static_cast<float>(result.gains.r()), 0.1f, 4.0f),
+			1.0f,
+			std::clamp(static_cast<float>(result.gains.b()), 0.1f, 4.0f),
+		} };
+		context.activeState.awb.temperatureK = result.colourTemperature;
+	} else {
+		/*
+		 * Запасной путь — прежний серый мир, если тюнинг без
+		 * colourGains. Максимальное усиление ограничено 4.0, заодно
+		 * это защищает от деления на ноль.
+		 */
+		gains = { {
+			sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
+			1.0,
+			sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+		} };
+
+		RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
+		context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+	}
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
 	LOG(IPASoftAwb, Debug)
