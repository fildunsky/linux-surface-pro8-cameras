%YAML 1.1
---
# Заводская калибровка Intel: источник света 3743 K.
# Awb намеренно отсутствует: баланс белого зашит в столбцы матрицы,
# иначе серый мир libcamera уводит цвет по всей сцене. Подробности —
# tools/factory-tuning.py и NOTES.md.
version: 1
algorithms:
  - BlackLevel:
  - Ccm:
      ccms:
        - ct: 3743
          ccm: [   1.1094,  -0.3103,  -0.1164,
                  -0.2186,   0.7677,  -0.2576,
                  -0.0807,  -0.3269,   1.8120 ]
  - Adjust:
  - Agc:
...
