%YAML 1.1
---
# Заводская калибровка Intel: источник света 3786 K.
# Awb намеренно отсутствует: баланс белого зашит в столбцы матрицы,
# иначе серый мир libcamera уводит цвет по всей сцене. Подробности —
# tools/factory-tuning.py и NOTES.md.
version: 1
algorithms:
  - BlackLevel:
  - Ccm:
      ccms:
        - ct: 3786
          ccm: [   1.7974,  -0.6675,   0.0125,
                  -0.2792,   1.0561,  -0.4634,
                  -0.1410,  -0.6118,   2.2048 ]
  - Adjust:
  - Agc:
...
