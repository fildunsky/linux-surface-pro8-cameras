# SPDX-License-Identifier: CC0-1.0
#
# Файл тюнинга libcamera для фронтальной камеры Surface Pro 8 (ov5693).
#
# Матрицы цветокоррекции взяты из репозитория dmanresa-saes/surface-ipu6-cameras
# (config/tuning/libcamera/ov5693.yaml). Там они получены расшифровкой
# заводского профиля Microsoft (.aiqb) для этого же сенсора — то есть это
# настоящая калибровка производителя на семь цветовых температур, с
# недиагональными членами, которые задают насыщенность и повороты оттенков.
#
# Прежний вариант — моя диагональная матрица, выведенная замером по белому
# потолку, — сохранён рядом как ov5693-measured.yaml.bak. Она убирала увод в
# зелень, но не могла восстановить насыщенность: подобрать недиагональные
# члены без цветовой мишени нельзя.
#
# Раздел Awb из их файла НЕ перенесён намеренно: он написан под алгоритм
# bayes с колонкой colourGains, а установленная здесь программная IPA
# (ipa_soft_simple.so) читает из файла только ключ ccms — её Awb параметров не
# принимает. Лишний раздел был бы мёртвым грузом и вводил бы в заблуждение.
#
# Проверка после установки — в NOTES.md, раздел про цветопередачу.
%YAML 1.1
---
version: 1
algorithms:
  - BlackLevel:
  - Awb:
  - Ccm:
      ccms:
        - ct: 2592
          ccm: [  2.5925, -0.6216, -0.6617,
                 -0.6684,  2.1544, -0.4860,
                 -1.1817, -4.1090,  7.5452 ]
        - ct: 2773
          ccm: [  2.8775, -1.2910, -0.2778,
                 -0.7359,  2.1626, -0.4264,
                 -0.5555, -3.3455,  6.1552 ]
        - ct: 3716
          ccm: [  3.0036, -1.4891, -0.2058,
                 -0.5846,  2.0326, -0.4481,
                 -0.3108, -2.3129,  4.8777 ]
        - ct: 3763
          ccm: [  2.9468, -1.4182, -0.2193,
                 -0.5637,  2.1049, -0.5412,
                 -0.2169, -2.7644,  5.2354 ]
        - ct: 4877
          ccm: [  2.7197, -1.0500, -0.3606,
                 -0.4319,  1.9676, -0.5358,
                 -0.2858, -2.0931,  4.6338 ]
        - ct: 5894
          ccm: [  2.7010, -1.0969, -0.2955,
                 -0.4043,  2.1383, -0.7340,
                 -0.2276, -2.0658,  4.5475 ]
        - ct: 6905
          ccm: [  2.8343, -1.2678, -0.2577,
                 -0.3738,  2.1203, -0.7465,
                 -0.1810, -1.9578,  4.3933 ]
  - Adjust:
  - Agc:
...
