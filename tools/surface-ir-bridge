#!/usr/bin/env python3
"""Мост ИК-камеры Surface Pro 8 в V4L2, включающийся по требованию.

Пока камера снимает, она запитана и горит диод приватности, поэтому
держать её открытой постоянно нельзя. Устроено так же, как v4l2-relayd
для цветных камер: устройство всегда на месте и всегда отдаёт кадры, но
до прихода потребителя это чёрная заставка, а сенсор обесточен.

Почему нужна заставка. v4l2loopback не отдаёт сторону захвата, пока
устройство не держит писатель с выставленным форматом: попытка чтения
даёт "unsupported stream type". Значит кто-то обязан писать всегда —
иначе потребитель не сможет даже открыть устройство, и событию об
открытии неоткуда взяться. Вхолостую это два кадра в секунду.

Кадры пишутся в петлю напрямую, через VIDIOC_S_FMT и write(). Раньше тут
стоял ffmpeg, которому мост переливал сырой поток в stdin, и это было
источником целого класса отказов: формат на петле живёт ровно столько,
сколько живёт писатель, поэтому любая смерть ffmpeg — даже с немедленным
перезапуском — оставляла секундную дыру, в которую VIDIOC_G_FMT отдавал
EINVAL. Ровно в неё попал запрос от экрана входа GDM на загрузке
(«failed to query current format»). Со своим писателем формат выставлен
один раз за всё время жизни процесса и не исчезает. Заодно пропала
подгонка потока по границе кадра: наружу уходят только целые кадры.

Как узнаём об открытии: событие v4l2loopback V4L2_EVENT_PRI_CLIENT_USAGE.
Его тип — 0x10E00001, а НЕ V4L2_EVENT_PRIVATE_START + 1, как можно
подумать по названию: в v4l2loopback.c к базе прибавлено собственное
смещение 0x08E00000. Второй код, 0x08000000, — для убунтовского патча;
подписываемся на оба, работает тот, который примут.
"""
import fcntl
import glob
import os
import select
import signal
import struct
import subprocess
import sys
import threading
import time

import numpy as np

EVENTS = (0x10E00001, 0x08000000)
VIDIOC_SUBSCRIBE_EVENT = 0x4020565A
# _IOR('V', 89, struct v4l2_event). Размер структуры 136, а не 128: в
# объединении есть v4l2_event_ctrl с полем __s64, из-за чего объединение
# выровнено на 8 байт, и после type появляется четырёхбайтовая дырка.
VIDIOC_DQEVENT = 0x80885659
# Поэтому же счётчик клиентов лежит по смещению 8, а не сразу за type.
COUNT_OFFSET = 8
# _IOWR('V', 5, struct v4l2_format), 208 байт: __u32 type, дырка на
# выравнивание (в объединении есть v4l2_window с указателем), дальше 200
# байт объединения, из которых нам нужны первые 48 — v4l2_pix_format.
VIDIOC_S_FMT = 0xC0D05605
BUF_TYPE_VIDEO_OUTPUT = 2
FOURCC_YUYV = 0x56595559
FIELD_NONE = 1
COLORSPACE_SRGB = 8

SETUP = "/usr/local/lib/surface-ir-setup.sh"
CAPTURE_ENTITY = os.environ.get("IR_CAPTURE_ENTITY", "Intel IPU6 ISYS Capture 40")


def _capture_node():
    """Найти узел захвата по имени сущности в media-графе.

    Номер /dev/videoN зависит от того, сколько петель v4l2loopback
    зарегистрировалось раньше драйвера ipu6, и меняется: на двух петлях
    эта сущность была /dev/video42, на трёх стала /dev/video43.
    Имя сущности при этом постоянно, от него и пляшем.
    """
    forced = os.environ.get("IR_CAPTURE")
    if forced:
        return forced
    try:
        out = subprocess.run(
            ["media-ctl", "-d", MEDIA, "-e", CAPTURE_ENTITY],
            capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        out = ""
    if not out.startswith("/dev/video"):
        sys.exit(f"не найден узел захвата для сущности {CAPTURE_ENTITY!r}")
    return out


MEDIA = os.environ.get("IR_MEDIA", "/dev/media0")
CAPTURE = _capture_node()
CARD = "Surface Camera IR"
W, H, STRIDE_PX, FPS = 644, 604, 672, 31
IDLE_FPS = 2
IN_FRAME = STRIDE_PX * H * 2       # 'Y10 ': 10 бит в 16-битной ячейке
OUT_BPL = W * 2
OUT_FRAME = OUT_BPL * H

# Перевод 10 бит в 8. Диапазон именно «телевизионный», 16..235, а не
# простой сдвиг на два бита: столько лет тут стоял ffmpeg, который для
# yuyv422 сжимает полный диапазон в этот, и лица в базе сняты такими.
# Сдвиг вместо этого дал бы картинку контрастнее, чем при постановке
# моделей, и схожесть поехала бы вниз. Расхождение с ffmpeg на реальном
# кадре — не больше единицы младшего разряда (у него ещё дизеринг).
LUT = np.clip(np.rint(16 + np.arange(1024) * 219 / 1023), 0, 255).astype(np.uint8)


def loopback_node():
    for p in glob.glob("/sys/devices/virtual/video4linux/*/name"):
        if open(p).read().strip() == CARD:
            return "/dev/" + os.path.basename(os.path.dirname(p))
    sys.exit(f"нет узла с меткой карты '{CARD}'")


class Sink:
    """Сторона записи в петлю: открыта всё время жизни процесса."""

    def __init__(self, dev):
        self.dev = dev
        self.fd = os.open(dev, os.O_RDWR)
        fmt = bytearray(208)
        struct.pack_into("=I", fmt, 0, BUF_TYPE_VIDEO_OUTPUT)
        struct.pack_into("=12I", fmt, 8,
                         W, H, FOURCC_YUYV, FIELD_NONE, OUT_BPL, OUT_FRAME,
                         COLORSPACE_SRGB, 0, 0, 0, 0, 0)
        fcntl.ioctl(self.fd, VIDIOC_S_FMT, fmt)
        got = struct.unpack_from("=12I", fmt, 8)
        if (got[0], got[1], got[2]) != (W, H, FOURCC_YUYV):
            sys.exit(f"петля не приняла формат: {got[:3]}")
        # Кадр наружу собирается на месте: яркость меняем, цветность нет.
        self.frame = np.empty((H, W, 2), np.uint8)
        self.frame[..., 1] = 128
        self.black = np.empty((H, W, 2), np.uint8)
        self.black[..., 0] = LUT[0]
        self.black[..., 1] = 128
        self.black = self.black.tobytes()

    def write(self, data):
        mv = memoryview(data)
        while mv:
            mv = mv[os.write(self.fd, mv):]

    def convert(self, raw):
        """'Y10 ' со строкой 672 пикселя -> YUYV 644x604."""
        src = np.frombuffer(raw, "<u2").reshape(H, STRIDE_PX)[:, :W]
        self.frame[..., 0] = LUT[src & 0x3FF]
        return self.frame.tobytes()

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass


class Bridge:
    def __init__(self, dev):
        self.sink = Sink(dev)
        self.camera = None
        self.lock = threading.Lock()
        self.stop = threading.Event()
        threading.Thread(target=self.pump, daemon=True).start()

    def _read_frame(self, cam):
        """Собрать ровно один кадр со стороны камеры.

        v4l2-ctl отдаёт поток кусками, на границу кадра они не попадают,
        поэтому кадр собирается по частям. Наружу уходят только целые
        кадры: писателю петли, в отличие от stdin ffmpeg, частичные
        данные отдавать нечем — write() принимает кадр целиком.
        """
        buf = bytearray(IN_FRAME)
        mv = memoryview(buf)
        off = 0
        while off < IN_FRAME:
            n = cam.stdout.readinto(mv[off:])
            if not n:
                return None
            off += n
            if self.stop.is_set():
                return None
        return buf

    def pump(self):
        """Единственный писатель: либо заставка, либо кадры с камеры."""
        while not self.stop.is_set():
            with self.lock:
                cam = self.camera
            try:
                if cam is None:
                    self.sink.write(self.sink.black)
                    time.sleep(1.0 / IDLE_FPS)
                    continue
                raw = self._read_frame(cam)
                if raw is None:
                    # камера отвалилась сама — вернуться к заставке
                    with self.lock:
                        if self.camera is cam:
                            self.camera = None
                    continue
                self.sink.write(self.sink.convert(raw))
            except OSError as e:
                print(f"ИК: петля не приняла кадр: {e}", flush=True)
                time.sleep(0.2)

    def start_camera(self):
        with self.lock:
            if self.camera:
                return
        subprocess.run([SETUP], stdout=subprocess.DEVNULL, check=True)
        proc = subprocess.Popen(
            ["v4l2-ctl", "-d", CAPTURE, "--stream-mmap", "--stream-to=-"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            bufsize=0)
        with self.lock:
            self.camera = proc
        print("ИК: потребитель пришёл, камера включена", flush=True)

    def stop_camera(self):
        with self.lock:
            proc, self.camera = self.camera, None
        if not proc:
            return
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        print("ИК: потребителей нет, камера обесточена", flush=True)

    def shutdown(self):
        self.stop.set()
        self.stop_camera()
        self.sink.close()


def main():
    dev = loopback_node()
    bridge = Bridge(dev)

    def bye(*_):
        bridge.shutdown()
        os._exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    fd = os.open(dev, os.O_RDWR)
    subscribed = []
    for et in EVENTS:
        try:
            fcntl.ioctl(fd, VIDIOC_SUBSCRIBE_EVENT,
                        struct.pack("=III5I", et, 0, 0, *([0] * 5)))
            subscribed.append(et)
        except OSError:
            pass
    if not subscribed:
        bridge.shutdown()
        sys.exit("v4l2loopback не отдаёт событие об открытии устройства")

    print(f"ИК: жду потребителей на {dev}", flush=True)
    poller = select.poll()
    poller.register(fd, select.POLLPRI)
    while True:
        if not poller.poll(2000):
            continue
        buf = bytearray(136)
        try:
            fcntl.ioctl(fd, VIDIOC_DQEVENT, buf)
        except OSError:
            continue
        etype = struct.unpack_from("=I", buf, 0)[0]
        count = struct.unpack_from("=I", buf, COUNT_OFFSET)[0]
        if etype not in subscribed:
            continue
        if count:
            bridge.start_camera()
        else:
            bridge.stop_camera()


if __name__ == "__main__":
    main()
