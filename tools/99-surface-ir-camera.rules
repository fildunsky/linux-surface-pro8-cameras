# Стабильное имя для виртуального устройства ИК-камеры.
#
# Номер узла v4l2loopback плавает от загрузки к загрузке: если модуль
# успевает раньше intel-ipu6, он занимает /dev/video0, если позже — уходит
# за /dev/video64. Поэтому всё, что ссылается на ИК-камеру (Howdy,
# например), должно ходить через это имя, а не через номер.
SUBSYSTEM=="video4linux", ATTR{name}=="Surface Camera IR", SYMLINK+="surface-ir-camera"
